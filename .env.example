# Firebase Client Configuration (Frontend)
# Copy this file to .env.local and replace with your actual Firebase project settings.
# Find these in Firebase Console -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Dedicated Firebase Cloud Function AI Endpoint URL
# If omitted or unconfigured, CampusFind automatically uses its built-in local NLP search engine.
# Example: https://us-central1-your_project_id.cloudfunctions.net/chatAssistant
VITE_AI_ENDPOINT_URL=

# -------------------------------------------------------------
# BACKEND ONLY (Never put this in .env.local or frontend code!)
# Configure this in Firebase Functions using Secret Manager or Functions Config:
# firebase functions:secrets:set GEMINI_API_KEY
# GEMINI_API_KEY=your_gemini_api_key_here
