rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /items/{userId}/{allPaths=**} {
      // Anyone can view item images
      allow read: if true;

      // Authenticated listing owners, staff, or administrators can upload item photos
      // Maximum size: 5MB, must be a valid image format
      allow write: if request.auth != null
                   && (request.auth.uid == userId || request.auth.token.admin == true || request.auth.token.authority == true)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
